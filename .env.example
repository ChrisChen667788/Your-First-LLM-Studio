# Local MLX gateway
# Leave empty to use ~/Library/Application Support/local-agent-lab/observability.
# Do not place mutable runtime state inside an iCloud or other sync-backed repo.
LOCAL_AGENT_DATA_DIR=
LOCAL_AGENT_BASE_URL=http://127.0.0.1:4000/v1
LOCAL_QWEN_0_6B_MODEL=local-qwen3-0.6b
LOCAL_QWEN_4B_4BIT_MODEL=local-qwen3-4b-4bit
LOCAL_QWEN35_4B_4BIT_MODEL=local-qwen35-4b-4bit
LOCAL_QWEN_0_6B_REPO=Qwen/Qwen3-0.6B-MLX-6bit
LOCAL_QWEN_4B_4BIT_REPO=mlx-community/Qwen3-4B-Instruct-2507-4bit
LOCAL_QWEN35_4B_4BIT_REPO=mlx-community/Qwen3.5-4B-4bit

# OpenAI / Codex
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CODEX_MODEL=gpt-5.3-codex
OPENAI_CODEX_THINKING_MODEL=gpt-5.3-codex
OPENAI_GPT54_MODEL=gpt-5.5
OPENAI_GPT54_THINKING_MODEL=gpt-5.5

# Claude-compatible endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://your-compatible-claude-endpoint.example/v1
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_THINKING_MODEL=claude-opus-4-6-thinking

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_MODEL=deepseek-v4-pro
DEEPSEEK_FALLBACK_MODELS=deepseek-v4-flash

# Shared OpenTelemetry / Langfuse trace export. Configure either a generic
# OTLP/HTTP collector or a Langfuse project. Secrets stay server-side.
OTEL_SERVICE_NAME=first-llm-studio
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=local

# Optional bearer token for the public OpenAI-compatible /v1 surface.
# FIRST_LLM_PUBLIC_API_KEY=
FIRST_LLM_PUBLIC_DEFAULT_TARGET_ID=local-qwen3-0.6b

# Enterprise Retrieval is strict: it does not label the local hash index as
# pgvector or cross-encoder retrieval when these services are absent.
# ENTERPRISE_RAG_DATABASE_URL=postgresql://first_llm:replace-me@127.0.0.1:5432/first_llm
# ENTERPRISE_RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# ENTERPRISE_RAG_EMBEDDING_API_KEY=
# ENTERPRISE_RAG_EMBEDDING_MODEL=nomic-embed-text
ENTERPRISE_RAG_EMBEDDING_DIMENSIONS=768
# ENTERPRISE_RAG_RERANKER_URL=http://127.0.0.1:8082/rerank
# ENTERPRISE_RAG_RERANKER_API_KEY=
# ENTERPRISE_RAG_RERANKER_MODEL=bge-reranker-v2-m3
ENTERPRISE_RAG_DATABASE_POOL_SIZE=6

# MiniMax Token Plan / API
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_THINKING_MODEL=MiniMax-M3

# Moonshot / Kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0905-preview
KIMI_THINKING_MODEL=kimi-k2-0905-preview

# Zhipu / GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7
GLM_THINKING_MODEL=glm-4.7

# Qwen / DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_THINKING_MODEL=qwen-plus

# ModelScope upload
MODELSCOPE_API_TOKEN=
MODELSCOPE_REPO_ID=haozi667788/first-llm-studio
# The web control plane binds to loopback by default. Configure an operator token
# before exposing it on a LAN or through a reverse proxy.
FIRST_LLM_WEB_HOST=127.0.0.1
FIRST_LLM_OPERATOR_TOKEN=
FIRST_LLM_WORKSPACE_ROOT=
# Team workspace context. Keep the secret unset for loopback-only single-user
# mode; configure it when a trusted identity proxy signs workspace headers.
FIRST_LLM_WORKSPACE_CONTEXT_SECRET=
FIRST_LLM_OPERATOR_ID=local-operator
FIRST_LLM_WORKSPACE_ID=local-workspace
FIRST_LLM_ORGANIZATION_ID=local-organization

# Enterprise identity bridge. The inbound FIRST_LLM_SCIM_BEARER_TOKEN protects
# this app's /api/scim/v2 endpoint; the provider token below is outbound-only.
FIRST_LLM_OIDC_ISSUER=
FIRST_LLM_OIDC_CLIENT_ID=
FIRST_LLM_SCIM_BEARER_TOKEN=
FIRST_LLM_SCIM_PROVIDER_BASE_URL=
FIRST_LLM_SCIM_PROVIDER_TOKEN=

# Durable workflow leases. Use a dedicated PostgreSQL role in managed runtimes.
FIRST_LLM_WORKFLOW_DATABASE_URL=
FIRST_LLM_USAGE_DATABASE_URL=

# Optional alternate root for completed Fine-tune release evidence manifests.
FIRST_LLM_RELEASE_EVIDENCE_DIR=
FIRST_LLM_QUALITY_SOURCE_DATA_DIR=
FIRST_LLM_MATH_VERIFY_PYTHON_BIN=
FIRST_LLM_EVALUATOR_BOOTSTRAP_PYTHON=python3.11
